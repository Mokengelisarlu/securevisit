{
  "expo": {
    "name": "SecureVisit Kiosk",
    "slug": "securevisit-kiosk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-512x512.png",
    "scheme": "securevisit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.securevisit.kiosk",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to capture visitor and vehicle photos during check-in.",
        "NSFaceIDUsageDescription": "SecureStore uses Face ID to protect stored device credentials."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0FDFA",
        "foregroundImage": "./assets/images/icon-512x512.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.securevisit.kiosk"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-128x128.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SecureVisit to access your camera to capture visitor photos."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "SecureStore uses Face ID to protect stored device credentials."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-512x512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDFA",
          "dark": {
            "backgroundColor": "#0D3D3A"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "TODO-set-me-in-expo-dev-account"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/TODO-set-me-in-expo-dev-account",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
